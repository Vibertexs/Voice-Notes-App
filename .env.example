# Copy to .env and fill in. .env is gitignored - never commit the real one.
# The cloud API (cloud_app.py) and the setup script both read it.

# ---- database (required) ---------------------------------------------------
# Atlas: Connect -> Drivers -> Python, then put the password in directly.
# If the password has @ : / or ? in it, percent-encode them or Atlas will
# read them as part of the URI and the connection will fail with a confusing
# authentication error.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=voiceflow

# ---- environment -----------------------------------------------------------
# development: a throwaway signing secret is generated if JWT_SECRET is empty
#              (everyone is signed out on restart), and reset codes are printed
#              to the log instead of emailed.
# production:  JWT_SECRET is required and must be 32+ characters.
ENVIRONMENT=development

# ---- tokens ----------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# ACCESS_TOKEN_MINUTES=15
# REFRESH_TOKEN_DAYS=30

# ---- email (password reset codes; optional) --------------------------------
# A free Resend key sends from onboarding@resend.dev to your own address only;
# verify a domain in Resend to email anyone.
RESEND_API_KEY=
# EMAIL_FROM=VoiceFlow <onboarding@resend.dev>

# ---- Sign in with Apple (optional) -----------------------------------------
# The iOS app's bundle id. Comma-separate several. Empty turns it off.
APPLE_CLIENT_IDS=

# ---- Sign in with Google (optional) ----------------------------------------
# The *Web* OAuth client id from Google Cloud Console (APIs & Services >
# Credentials). Not the Android one: the phone library asks Google for a token
# addressed to the Web client, and that is what the server checks. Empty = off.
GOOGLE_CLIENT_IDS=

# ---- HTTP ------------------------------------------------------------------
# Only for a browser client; the phone app is not subject to CORS.
# ALLOWED_ORIGINS=https://app.example.com
# DOCS_ENABLED=true        # interactive API docs at /docs
# SEARCH_BACKEND=auto      # auto | atlas | regex
